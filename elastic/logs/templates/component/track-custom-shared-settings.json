{% set p_include_non_serverless_index_settings = (include_non_serverless_index_settings | default(build_flavor != "serverless")) -%}
{
  "template": {
    "settings": {
        {#- non-serverless-index-settings-marker-start #}
        {%- if build_flavor != "serverless" or serverless_operator == true %}
        {%- if p_include_non_serverless_index_settings %}
        "index.number_of_shards": "{{ number_of_shards | default(1) }}",
        "index.number_of_replicas": "{{ number_of_replicas | default(1) }}"}{%- if refresh_interval -%},{%- endif -%}
        {%- if refresh_interval -%},
        "index.refresh_interval": {{ refresh_interval | tojson }}{%- if index_mode -%},{%- endif -%}
        {%- endif %}
        {%- endif %}
        {%- endif %}
        {#- non-serverless-index-settings-marker-end #} 
        {% if index_mode %}
        "index.mode": {{ index_mode | tojson }}{%- if codec -%},{%- endif -%}
        {% endif %}
        {% if codec %}
        ,"index.codec": {{codec | tojson}}{%- if source_mode -%},{%- endif -%}
        {% endif %}
        {% if source_mode %}
        ,"index.mapping.source.mode": {{ source_mode | tojson }}{%- if use_synthetic_source_recovery -%},{%- endif -%}
        {% endif %}
        {% if use_synthetic_source_recovery %}
        ,"index.recovery.use_synthetic_source": {{use_synthetic_source_recovery | tojson}}{%- if synthetic_source_keep -%},{%- endif -%}
        {% endif %}
        {% if synthetic_source_keep %}
        "index.mapping.synthetic_source_keep": {{ synthetic_source_keep | tojson }}{%- if use_doc_values_skipper -%},{%- endif -%}
        {% endif %}
        {% if use_doc_values_skipper %}
        "index.mapping.use_doc_values_skipper": {{ use_doc_values_skipper | tojson }}
        {% endif %}
      }
    }
  }
}